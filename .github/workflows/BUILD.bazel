load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("//bazel/lint:linters.bzl", "shellcheck_test")

# Invoked by a human rehearsing a release, not by Bazel — but it validates the
# archive BCR consumes, so it is worth linting like anything else.
sh_library(
    name = "release_prep",
    srcs = ["release_prep.sh"],
)

shellcheck_test(
    name = "release_prep_lint",
    srcs = [":release_prep"],
    tags = ["lint"],
)
