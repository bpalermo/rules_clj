# Hermetic JDK, stated for target and tool alike. The tool runtime is the one that
# matters most here: it runs the compiler shim, so a build's Clojure compilation is
# only as reproducible as the JVM it happens on.
build --java_language_version=21
build --java_runtime_version=remotejdk_21
build --tool_java_language_version=21
build --tool_java_runtime_version=remotejdk_21

test --test_output=errors
test --verbose_failures
