"""The Maven publisher.

Like the compiler shim next door, it has no `deps` and must never gain any: a ruleset
that needs a dependency resolver in order to build itself makes every consumer pay for
it, and this is the tool that would tempt someone to add one. Five HTTP PUTs per
artifact — the file and its four checksums — do not need Aether.
"""

load("@rules_java//java:defs.bzl", "java_binary", "java_library")

package(default_visibility = ["//visibility:public"])

# A library as well as a binary, so a test can put these classes on its own classpath
# and call the publisher in-process rather than guessing at a subprocess's output.
java_library(
    name = "publisher_lib",
    srcs = ["Publisher.java"],
)

java_binary(
    name = "publisher",
    main_class = "dev.palermo.rulesclj.maven.Publisher",
    runtime_deps = [":publisher_lib"],
)
