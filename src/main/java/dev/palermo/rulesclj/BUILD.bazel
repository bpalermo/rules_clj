"""The compiler shim.

Deliberately has no `deps`, and must never gain any. This code runs on the same
classpath as the user's application, so anything it brings can collide with what
they brought — see docs/design.md. Clojure is reached by reflection, not linkage.
"""

load("@rules_java//java:defs.bzl", "java_binary", "java_library")

package(default_visibility = ["//visibility:public"])

# A library as well as a binary, so that a test can put these classes on its own
# classpath and drive the shim as a subprocess.
java_library(
    name = "aot_lib",
    srcs = [
        "Aot.java",
        "ClassRefs.java",
        "Jars.java",
        "Json.java",
        "Worker.java",
    ],
)

java_binary(
    name = "aot",
    main_class = "dev.palermo.rulesclj.Aot",
    runtime_deps = [":aot_lib"],
)

# The same code as :aot, started in worker mode by Bazel. A separate target because a
# worker's executable is the thing Bazel launches once and then feeds requests to.
# A warm JVM is what the worker is for, and it is also what made its output
# non-deterministic: Clojure's compiler emits locals-clearing instructions by walking
# maps keyed on objects that use identity hash codes, and HotSpot's identity hashes come
# from a per-thread PRNG whose sequence depends on how much the JVM has already done.
# A fresh JVM per action replays the same sequence and emits the same bytes; a warm one
# does not, so the same source compiled after different neighbours produced jars
# differing in a dozen anonymous fn classes. Pinning the hash to a constant removes the
# variable the emission order rides on.
#
# Experimental because HotSpot classifies it so, not because its behaviour is unclear:
# hashCode=2 makes every IDENTITY hash 1 — what System.identityHashCode returns, and what
# Object.hashCode returns for a class that does not override it. A class that computes its
# own hash, String for one, is untouched. Nothing here depends on identity hashes being
# distinct: the compiler runs, writes classes and exits. The cost is confined to maps keyed
# by identity inside one compile, where every key now collides.
java_binary(
    name = "worker",
    args = ["--persistent_worker"],
    jvm_flags = [
        # A JVM without these flags must still start: they are HotSpot's, the exec JDK is
        # whatever a consumer registered, and a compiler that refuses to run is worse than
        # one that runs non-deterministically. What must not happen is losing determinism
        # silently, so the worker checks at startup whether the pin took and says so if it
        # did not — see Worker.warnIfIdentityHashesAreNotPinned.
        "-XX:+IgnoreUnrecognizedVMOptions",
        "-XX:+UnlockExperimentalVMOptions",
        "-XX:hashCode=2",
    ],
    main_class = "dev.palermo.rulesclj.Aot",
    runtime_deps = [":aot_lib"],
)
