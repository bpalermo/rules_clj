;; VENDORED FIXTURE — clj-grpc's deps.edn at v0.1.4, copied verbatim.
;;
;; Paired with clj-grpc-0.1.4.pom, the pom that was actually deployed to Clojars from
;; it by tools.build. //tests/maven:pom_gen_test regenerates the pom from this file and
;; requires the two to agree dependency-for-dependency. Do not tidy either of them:
;; their value is that they are what shipped.
;; An ordinary deps.edn, consumed by Bazel through the committed lockfile
;; (regenerate with rules_clj's //tools/lock) and by Clojars consumers through
;; the published pom.
;;
;; NON-SHADED NETTY, deliberately. grpc-netty-shaded hides the version
;; alignment problem but makes the native transports unreachable —
;; netty-transport-native-epoll cannot be used against shaded class names, and
;; epoll is how both Unix domain sockets and the fast path work here. The cost
;; of non-shaded is that gRPC and Netty versions must be aligned BY HAND:
;;
;;   grpc-java SECURITY.md pairing (the authority):
;;     grpc 1.81.x+  <->  netty 4.2.16.Final  <->  tcnative 2.0.81.Final
;;
;; Every netty artifact is pinned at top level because tools.deps gives
;; top-level deps absolute precedence over transitive pom ranges — this is the
;; alignment mechanism. //test:netty_alignment_test fails the build if any
;; loaded netty jar reports a different version, so a grpc bump that forgets
;; this block is caught in CI, not in production.
;;
;; netty-tcnative-boringssl-static 2.0.81.Final is deliberately absent: h2c
;; (Knative's protocol) needs no TLS provider, and JDK TLS works where TLS is
;; wanted. Document-only add-on.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        com.github.bpalermo/clj-protobuf {:mvn/version "0.1.6"}

        io.grpc/grpc-api {:mvn/version "1.83.1"}
        io.grpc/grpc-core {:mvn/version "1.83.1"}
        io.grpc/grpc-netty {:mvn/version "1.83.1"}
        io.grpc/grpc-protobuf {:mvn/version "1.83.1"}
        io.grpc/grpc-stub {:mvn/version "1.83.1"}
        ;; Health + reflection services, both of which Knative deployments want.
        io.grpc/grpc-services {:mvn/version "1.83.1"}

        io.netty/netty-buffer {:mvn/version "4.2.16.Final"}
        io.netty/netty-codec {:mvn/version "4.2.16.Final"}
        io.netty/netty-codec-base {:mvn/version "4.2.16.Final"}
        io.netty/netty-codec-http {:mvn/version "4.2.16.Final"}
        io.netty/netty-codec-http2 {:mvn/version "4.2.16.Final"}
        io.netty/netty-common {:mvn/version "4.2.16.Final"}
        io.netty/netty-handler {:mvn/version "4.2.16.Final"}
        ;; grpc-netty's pom drags these two in at whatever version it was built
        ;; against (4.2.15 for grpc 1.83.1) — the alignment test caught exactly
        ;; that on its first run, which is the test's whole job.
        io.netty/netty-codec-socks {:mvn/version "4.2.16.Final"}
        io.netty/netty-handler-proxy {:mvn/version "4.2.16.Final"}
        io.netty/netty-resolver {:mvn/version "4.2.16.Final"}
        io.netty/netty-transport {:mvn/version "4.2.16.Final"}
        io.netty/netty-transport-native-unix-common {:mvn/version "4.2.16.Final"}
        ;; The native epoll transport, one artifact per arch. Loaded lazily by
        ;; Netty; harmless on macOS where Epoll/isAvailable is simply false.
        io.netty/netty-transport-native-epoll$linux-x86_64 {:mvn/version "4.2.16.Final"}
        io.netty/netty-transport-native-epoll$linux-aarch_64 {:mvn/version "4.2.16.Final"}}
 :aliases
 {;; service-test is deliberately absent from the patterns: its protoc
  ;; reference classes come from Bazel's java_proto_library, which plain clj
  ;; cannot build. Bazel runs the complete suite; the e2e suite here runs the
  ;; hint-free (DynamicMessage) arm, which is its own coverage.
  :test {:extra-paths ["test" "test/fixtures"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test
         :exec-args {:patterns ["clj-grpc\\.(e2e|lazy-netty|netty-alignment)-test"]}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}}
          :ns-default build}
  ;; bazel run //bench:run — gRPC round trips vs REST+JSON on Pedestal/Jetty.
  :bench {:extra-paths ["bench" "test/fixtures"]
          :extra-deps {criterium/criterium {:mvn/version "0.4.6"}
                       metosin/jsonista {:mvn/version "0.3.13"}
                       io.pedestal/pedestal.service {:mvn/version "0.8.1"}
                       io.pedestal/pedestal.jetty {:mvn/version "0.8.1"}}}}}
