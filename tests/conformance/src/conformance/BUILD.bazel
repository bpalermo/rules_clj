"""Conformance fixtures.

One target per namespace, deliberately: each `clj_library` is a separate compilation,
so the boundaries these tests care about — a protocol's interface, a deftype's class,
a macro's availability — are real rather than simulated by a single big compile.
"""

load("@rules_java//java:defs.bzl", "java_import")
load("//clojure:defs.bzl", "clj_library")

package(default_visibility = ["//tests/conformance:__subpackages__"])

clj_library(
    name = "protocols",
    srcs = ["protocols.clj"],
    namespaces = ["conformance.protocols"],
    strip_prefix = "tests/conformance/src",
)

clj_library(
    name = "protocol_user",
    srcs = ["protocol_user.clj"],
    namespaces = ["conformance.protocol-user"],
    strip_prefix = "tests/conformance/src",
    deps = [":protocols"],
)

clj_library(
    name = "types",
    srcs = ["types.clj"],
    namespaces = ["conformance.types"],
    strip_prefix = "tests/conformance/src",
)

clj_library(
    name = "type_user",
    srcs = ["type_user.clj"],
    namespaces = ["conformance.type-user"],
    strip_prefix = "tests/conformance/src",
    deps = [":types"],
)

clj_library(
    name = "macros",
    srcs = ["macros.clj"],
    namespaces = ["conformance.macros"],
    strip_prefix = "tests/conformance/src",
)

clj_library(
    name = "macro_user",
    srcs = ["macro_user.clj"],
    namespaces = ["conformance.macro-user"],
    strip_prefix = "tests/conformance/src",
    deps = [":macros"],
)

clj_library(
    name = "chain_c",
    srcs = ["chain_c.clj"],
    namespaces = ["conformance.chain-c"],
    strip_prefix = "tests/conformance/src",
)

clj_library(
    name = "chain_b",
    srcs = ["chain_b.clj"],
    namespaces = ["conformance.chain-b"],
    strip_prefix = "tests/conformance/src",
    deps = [":chain_c"],
)

clj_library(
    name = "chain_a",
    srcs = ["chain_a.clj"],
    namespaces = ["conformance.chain-a"],
    strip_prefix = "tests/conformance/src",
    deps = [":chain_b"],
)

clj_library(
    name = "readers",
    srcs = ["readers.clj"],
    namespaces = ["conformance.readers"],
    strip_prefix = "tests/conformance/src",
)

# data_readers.clj must sit at the root of the classpath, which is what makes it a
# resource of this target rather than a source of it.
clj_library(
    name = "reader_user",
    srcs = ["reader_user.clj"],
    namespaces = ["conformance.reader-user"],
    resources = ["//tests/conformance/src:data_readers"],
    strip_prefix = "tests/conformance/src",
    deps = [":readers"],
)

# The one target that is not compiled, so that the mixed case is covered.
clj_library(
    name = "interpreted",
    srcs = ["interpreted.clj"],
    aot = False,
    namespaces = ["conformance.interpreted"],
    strip_prefix = "tests/conformance/src",
)

# The direct-linking fixture: one callee, and the same caller source compiled both
# ways. Two targets rather than a flag flip, so one test can observe both.
clj_library(
    name = "linked_callee",
    srcs = ["linked_callee.clj"],
    namespaces = ["conformance.linked-callee"],
    strip_prefix = "tests/conformance/src",
)

clj_library(
    name = "linked_caller_off",
    srcs = ["linked_caller.clj"],
    direct_linking = "off",
    namespaces = ["conformance.linked-caller"],
    strip_prefix = "tests/conformance/src",
    deps = [":linked_callee"],
)

# Same source, same namespace: only one of these two may be on a classpath at a time,
# which is why the test that uses them runs them in separate targets.
clj_library(
    name = "linked_caller_on",
    srcs = ["linked_caller.clj"],
    direct_linking = "on",
    namespaces = ["conformance.linked-caller"],
    strip_prefix = "tests/conformance/src",
    deps = [":linked_callee"],
)

# A stand-in for a Clojure library published to Maven: sources in a jar, no classes.
# Built here rather than pulled from a repository so the test does not depend on the
# network or on someone else's release staying source-only.
genrule(
    name = "jarred_source_jar",
    srcs = ["jarred.clj"],
    outs = ["jarred-sources.jar"],
    cmd = "$(location @bazel_tools//tools/zip:zipper) c $@ conformance/jarred.clj=$(location jarred.clj)",
    tools = ["@bazel_tools//tools/zip:zipper"],
)

java_import(
    name = "jarred_jar",
    jars = ["jarred-sources.jar"],
)

# Compiling a namespace out of that jar: no srcs, the sources come from the dep. This
# is what lets a consumer link into a library that ships as source — see #18.
clj_library(
    name = "jarred_compiled",
    namespaces = ["conformance.jarred"],
    deps = [":jarred_jar"],
)

clj_library(
    name = "jarred_caller_linked",
    srcs = ["jarred_caller.clj"],
    direct_linking = "on",
    namespaces = ["conformance.jarred-caller"],
    strip_prefix = "tests/conformance/src",
    deps = [":jarred_compiled"],
)
