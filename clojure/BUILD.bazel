"""The public API.

Consumers load from `@rules_clj//clojure:defs.bzl` and from nowhere else; every
other package in this repository is an implementation detail and may change
without notice.
"""

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")

package(default_visibility = ["//visibility:public"])

exports_files([
    "defs.bzl",
    "extensions.bzl",
    "native_toolchain.bzl",
    "toolchain.bzl",
])

# Resolved by clj_library, and re-exported to the java_* macros through
# //clojure/runtime:clojure. See clojure/toolchain.bzl.
toolchain_type(name = "toolchain_type")

# Separate from the Clojure toolchain: only a build that produces a native binary needs a
# GraalVM, and nobody should download one to discover they did not want it.
toolchain_type(name = "native_toolchain_type")

# How compile actions use the class data sharing archive (clojure/private/cds.bzl):
#
#   off   do not pass it at all — THE DEFAULT, and see below for why
#   auto  use it if the JVM accepts it, carry on if not
#   on    require it; the action fails if it cannot be mapped
#
# Off by default because the measurement went against it. The archive does make each
# compile JVM about 28% faster to start (0.34s -> 0.245s here). But an archive records
# the timestamps of the jars it was dumped with, so one restored from a cache was dumped
# against timestamps that no longer hold and is silently ignored — which means it can
# only be correct if it is never cached, dumped fresh in the build that uses it.
#
# And an uncacheable input is a poisoned one: its digest changes every clean build, so
# every compile action that consumes it changes key too, and none of them can hit the
# action cache. Measured on a 40-namespace project, rebuild after `bazel clean` went
# from 2s to 15s. Trading the action cache for 0.1s per action is a bad trade at any
# project size.
#
# Left in place rather than deleted because the flag is how the finding stays
# reproducible: tools/benchmark/benchmark.sh flips it. See docs/design.md.
string_flag(
    name = "cds",
    build_setting_default = "off",
    values = [
        "auto",
        "off",
        "on",
    ],
)

# Whether compile actions go through a Bazel persistent worker.
#
# On by default: a worker keeps one JVM alive across targets, which removes JVM startup
# and gives the JIT a chance to warm up. It does NOT share a Clojure runtime between
# targets — each request loads its own in its own classloader, because a shared runtime
# carries one target's namespaces into the next and makes compilation order-dependent.
#
# Turn it off to compare, or when debugging a compile that misbehaves: without the
# worker each action is an ordinary short-lived JVM, which is easier to reason about and
# to run by hand.
bool_flag(
    name = "worker",
    build_setting_default = True,
)
