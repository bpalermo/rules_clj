# ClojureScript, compiled through the same dependency machinery as everything else: the
# ClojureScript compiler is an ordinary entry in this project's deps.edn, not something
# the ruleset pins on the project's behalf.
module(
    name = "rules_clj_example_cljs",
    version = "0.0.0",
)

bazel_dep(name = "rules_clj", version = "0.2.2")
local_path_override(
    module_name = "rules_clj",
    path = "../..",
)

deps = use_extension("@rules_clj//clojure:extensions.bzl", "deps")
deps.install(
    name = "deps",
    lock = "//:deps.lock.json",
)
use_repo(deps, "deps")
